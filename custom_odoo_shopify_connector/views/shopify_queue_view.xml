<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_shopify_import_queue_list" model="ir.ui.view">
        <field name="name">shopify.import.queue.list</field>
        <field name="model">shopify.import.queue</field>
        <field name="arch" type="xml">
            <list string="Shopify Import Queue">
                <field name="create_date"/>
                <field name="store_id"/>
                <field name="operation_type"/>
                <field name="status"/>
                <field name="error_summary"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="records_to_process"/>
                <field name="processed_records"/>
            </list>
        </field>
    </record>

    <record id="view_shopify_import_queue_search" model="ir.ui.view">
        <field name="name">shopify.import.queue.search</field>
        <field name="model">shopify.import.queue</field>
        <field name="arch" type="xml">
            <search string="Search Import Queue">
                <field name="store_id"/>
                <field name="operation_type"/>
                <field name="status"/>
                <filter name="pending" string="Pending" domain="[('status', '=', 'pending')]"/>
                <filter name="processing" string="Processing" domain="[('status', '=', 'processing')]"/>
                <filter name="failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <filter name="done" string="Done" domain="[('status', '=', 'done')]"/>
                <filter name="last_24h" string="Last 24h" domain="[('create_date', '>=', (context_today() - relativedelta(days=1)).strftime('%%Y-%%m-%%d 00:00:00'))]"/>
                <separator/>
                <filter name="by_store" string="By Store" context="{'group_by': 'store_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_shopify_import_queue_form" model="ir.ui.view">
        <field name="name">shopify.import.queue.form</field>
        <field name="model">shopify.import.queue</field>
        <field name="arch" type="xml">
            <form string="Shopify Import Queue">
                <header>
                    <button name="action_process_queue_manually"
                            type="object"
                            string="Process Queue Manually"
                            class="btn-primary"
                            invisible="status != 'pending'"/>
                    <button name="action_retry_failed" type="object" string="Retry Failed" class="btn-primary" invisible="status != 'failed'"/>
                    <button name="action_reset_to_pending" type="object" string="Reset to Pending" class="btn-secondary" invisible="status == 'pending'"/>
                    <button name="action_open_logs" type="object" string="Open Sync Logs" class="btn-secondary"/>
                    <button name="action_open_related_records" type="object" string="Open Related Records" class="btn-secondary"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,processing,done,failed"/>
                    <field name="retry_count" string="Retries" readonly="1"/>
                    <field name="last_error" string="Last Error" readonly="1"/>
                    <field name="write_date" string="Last Run" readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="store_id"/>
                            <field name="operation_type"/>
                            <field name="next_retry_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="records_to_process" readonly="1"/>
                        <field name="processed_records" readonly="1"/>
                    </group>
                    <group>
                        <field name="error_message" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shopify_import_queue" model="ir.actions.act_window">
        <field name="name">Import Queue</field>
        <field name="res_model">shopify.import.queue</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_shopify_import_queue_search"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

</odoo>

