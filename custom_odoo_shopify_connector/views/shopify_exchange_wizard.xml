<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_exchange_wizard_form" model="ir.ui.view">
        <field name="name">shopify.exchange.wizard.form</field>
        <field name="model">shopify.exchange.wizard</field>
        <field name="arch" type="xml">
            <form string="Shopify Exchange">
                <group>
                    <field name="sale_order_id" readonly="1"/>
                    <field name="store_id" readonly="1"/>
                    <field name="note"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="sale_line_id" readonly="1"/>
                        <field name="return_qty"/>
                        <field name="replacement_product_id"/>
                        <field name="replacement_qty"/>
                    </list>
                </field>
                <footer>
                    <button name="action_process_exchange" type="object" string="Process Exchange" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
